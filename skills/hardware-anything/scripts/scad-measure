#!/usr/bin/env bash
# scad-measure - render an OpenSCAD file to STL and print what a caliper would read: bounding box, volume, triangles.
#
# usage: scad-measure [-0] [-e X,Y,Z] [-t TOL] [-D name=value]... FILE.scad
#   -0         expect an EMPTY result and exit 0 only then: the interference test (intersection() of two parts that
#              must not touch)
#   -e X,Y,Z   expected bounding box in mm; exit 1 when any side is off by more than TOL
#   -t TOL     tolerance in mm for -e (default 0.01)
#   -D n=v     set a parameter, as openscad -D (repeatable)
# Prints: size X Y Z in mm, min corner, volume in mm^3 (and cm^3), triangle count. A mesh that is not closed
# (an edge used by an odd number of triangles) is reported, because its volume means nothing.
# Exit 0 fine, 1 measurement off or mesh open, 2 bad usage or render failed.

case ${1:-} in -h | --help | '') awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac
exp="" tol=0.01 defs=() none=0
while [ $# -gt 1 ]; do
	case $1 in
		-0) none=1 ;;
		-e) exp=$2; shift ;;
		-t) tol=$2; shift ;;
		-D) defs+=(-D "$2"); shift ;;
		*) echo "scad-measure: unknown option $1" >&2; exit 2 ;;
	esac
	shift
done
f=$1
[ -f "$f" ] || { echo "scad-measure: no such file: $f" >&2; exit 2; }
command -v openscad > /dev/null || { echo "scad-measure: openscad not installed" >&2; exit 2; }
tmp=$(mktemp -d) && trap 'rm -rf -- "$tmp"' EXIT
openscad "${defs[@]}" -o "$tmp/m.stl" "$f" > "$tmp/log" 2>&1 || grep -q "object is empty" "$tmp/log" || { cat "$tmp/log" >&2; exit 2; }
if [ ! -s "$tmp/m.stl" ]; then
	if [ "$none" = 1 ]; then echo "empty, as expected"; exit 0; fi
	echo "scad-measure: the model is empty"; exit 1
fi
[ "$none" = 1 ] && { echo "scad-measure: expected nothing but the model has a body"; }
grep -E 'WARNING|ERROR' "$tmp/log" >&2
python3 -I - "$tmp/m.stl" "$exp" "$tol" "$none" << 'PY'
import sys, re, collections
path, exp, tol = sys.argv[1], sys.argv[2], float(sys.argv[3])
tri, cur = [], []
for line in open(path):
    m = re.match(r'\s*vertex\s+(\S+)\s+(\S+)\s+(\S+)', line)
    if m:
        cur.append(tuple(float(x) for x in m.groups()))
        if len(cur) == 3:
            tri.append(cur); cur = []
if not tri:
    print("scad-measure: the model is empty"); sys.exit(1)
lo = [min(v[i] for t in tri for v in t) for i in range(3)]
hi = [max(v[i] for t in tri for v in t) for i in range(3)]
size = [h - l for h, l in zip(hi, lo)]
vol = 0.0
for a, b, c in tri:
    vol += (a[0]*(b[1]*c[2]-b[2]*c[1]) - a[1]*(b[0]*c[2]-b[2]*c[0]) + a[2]*(b[0]*c[1]-b[1]*c[0])) / 6.0
edges = collections.Counter()
for t in tri:
    for i in range(3):
        p, q = t[i], t[(i+1) % 3]
        edges[(p, q) if p < q else (q, p)] += 1
open_edges = sum(1 for n in edges.values() if n % 2)
print("size   %.3f x %.3f x %.3f mm" % tuple(size))
print("min    %.3f %.3f %.3f" % tuple(lo))
print("volume %.2f mm3 (%.3f cm3)" % (abs(vol), abs(vol) / 1000))
print("tris   %d%s" % (len(tri), "" if not open_edges else "   OPEN MESH: %d edges used an odd number of times" % open_edges))
bad = open_edges > 0
if exp:
    want = [float(x) for x in exp.split(",")]
    for axis, w, s in zip("XYZ", want, size):
        if abs(w - s) > tol:
            print("%s is %.3f, expected %.3f (tolerance %.3f)" % (axis, s, w, tol)); bad = True
sys.exit(1 if bad or sys.argv[4] == "1" else 0)
PY
