#!/usr/bin/env bats
# bin/skills against throwaway skill folders; nothing outside $BATS_TEST_TMPDIR is touched.

setup() {
	S=$BATS_TEST_DIRNAME/../bin/skills
	export SKILLS_DIR=$BATS_TEST_TMPDIR/skills HOME=$BATS_TEST_TMPDIR/home XDG_DATA_HOME=$BATS_TEST_TMPDIR/home/.local/share
	mkdir -p "$SKILLS_DIR" "$HOME"
	unset CLAUDE_CONFIG_DIR
	mk alpha 1 '#bash #cli' 'cmd:sh ?cmd:no-such-tool-here skill:beta' 'Alpha does a thing. Second sentence.'
	mk beta 0 '#core' 'env:HOME'
	mkdir -p "$SKILLS_DIR/claude"
	printf -- '---\nname: claude\ndescription: The map.\nmetadata:\n  priority: "0"\n  tags: "#meta"\n---\n\n# Map\n\n%s\n%s\n' \
		'<!-- skills:index generated by bin/skills index; edit the skills, not this block -->' '<!-- /skills:index -->' > "$SKILLS_DIR/claude/SKILL.md"
}

mk() {	# mk NAME PRIORITY TAGS REQUIRES [DESCRIPTION]
	mkdir -p "$SKILLS_DIR/$1"
	{
		printf -- '---\nname: %s\ndescription: %s\nmetadata:\n  priority: "%s"\n  tags: "%s"\n' "$1" "${5:-$1 skill.}" "$2" "$3"
		[ -z "$4" ] || printf '  requires: "%s"\n' "$4"
		printf -- '---\n\n# %s\n\nBody.\n' "$1"
	} > "$SKILLS_DIR/$1/SKILL.md"
}

@test "ls: one TSV row per skill, filtered by #tag with or without the hash" {
	run "$S" ls
	[ "$status" -eq 0 ]
	[[ "$output" == *$'alpha\t1\t#bash #cli\tAlpha does a thing. Second sentence.'* ]]
	[ "$(printf '%s\n' "$output" | wc -l)" -eq 3 ]
	run "$S" ls '#bash'
	[ "$output" = $'alpha\t1\t#bash #cli\tAlpha does a thing. Second sentence.' ]
	run "$S" ls cli bash
	[ "${lines[0]%%$'\t'*}" = alpha ]
	run "$S" ls '#nothing'
	[ "$status" -eq 1 ]
}

@test "tags: count and skills per tag" {
	run "$S" tags
	[ "$status" -eq 0 ]
	[[ "$output" == *$'#bash\t1\talpha'* ]]
	[[ "$output" == *$'#core\t1\tbeta'* ]]
}

@test "index fills the block, check passes, a stale index fails check" {
	run "$S" check
	[ "$status" -eq 1 ]
	[[ "$output" == *"index is stale"* ]]
	run "$S" index
	[ "$status" -eq 0 ]
	grep -qxF -- '- `beta` #core' "$SKILLS_DIR/claude/SKILL.md"
	grep -qxF -- '- `alpha` #bash #cli' "$SKILLS_DIR/claude/SKILL.md"
	grep -qF -- '### Priority 0 - always' "$SKILLS_DIR/claude/SKILL.md"
	run "$S" check
	[ "$status" -eq 0 ]
	before=$(cat "$SKILLS_DIR/claude/SKILL.md")
	"$S" index
	[ "$(cat "$SKILLS_DIR/claude/SKILL.md")" = "$before" ]
}

@test "check: names every broken rule" {
	"$S" index
	mk gamma 5 'bash' 'tool:x skill:nope'
	mkdir -p "$SKILLS_DIR/delta"
	printf -- '---\nname: other\ndescription: Use when: things <break>\ntags: x\n---\nbody\n' > "$SKILLS_DIR/delta/SKILL.md"
	run "$S" check gamma delta
	[ "$status" -eq 1 ]
	[[ "$output" == *"gamma: metadata.priority: 0, 1, 2 or 3"* ]]
	[[ "$output" == *"gamma: tag 'bash': #lowercase-words"* ]]
	[[ "$output" == *"gamma: requires 'tool:x': TYPE:VALUE"* ]]
	[[ "$output" == *"gamma: requires skill:nope, which is not in this repo"* ]]
	[[ "$output" == *"delta: description: quote this value"* ]]
	[[ "$output" == *"delta: name 'other' is not the folder name 'delta'"* ]]
	[[ "$output" == *"delta: unknown key tags"* ]]
	[[ "$output" == *"delta: description: no angle brackets"* ]]
}

@test "check: skills requiring each other in a loop" {
	mk beta 0 '#core' 'skill:alpha'
	"$S" index
	run "$S" check
	[ "$status" -eq 1 ]
	[[ "$output" == *"in a loop"* ]]
}

@test "req: ok, optional and missing items, skill requirements followed" {
	run "$S" req alpha
	[ "$status" -eq 0 ]
	[[ "$output" == *$'ok\tcmd:sh\t'* ]]
	[[ "$output" == *$'optional\t?cmd:no-such-tool-here'* ]]
	[[ "$output" == *"# beta"* ]]
	[[ "$output" == *$'ok\tenv:HOME\tset'* ]]
	mk beta 0 '#core' 'env:SKILLS_TEST_UNSET_VAR file:~/nowhere'
	run "$S" req alpha
	[ "$status" -eq 1 ]
	[[ "$output" == *$'missing\tenv:SKILLS_TEST_UNSET_VAR'* ]]
	[[ "$output" == *$'missing\tfile:~/nowhere'* ]]
	run "$S" req nope
	[ "$status" -eq 1 ]
}

@test "install: links every skill, trashes what was in the way, then has nothing to do" {
	dest=$HOME/.claude/skills
	mkdir -p "$dest/alpha" && echo old > "$dest/alpha/SKILL.md"
	run "$S" install -n
	[ "$status" -eq 0 ]
	[[ "$output" == *"trash $dest/alpha"* ]]
	[ -f "$dest/alpha/SKILL.md" ] && [ ! -L "$dest/alpha" ]
	run "$S" install
	[ "$status" -eq 0 ]
	[ -L "$dest/alpha" ] && [ "$(readlink -f "$dest/alpha")" = "$(readlink -f "$SKILLS_DIR/alpha")" ]
	[ -L "$dest/beta" ] && [ -L "$dest/claude" ]
	grep -rqx old "$XDG_DATA_HOME/Trash/files"
	run "$S" install
	[ "$status" -eq 0 ] && [ -z "$output" ]
	mv "$SKILLS_DIR/beta" "$BATS_TEST_TMPDIR/beta-moved"
	run "$S" install
	[[ "$output" == *"trash $dest/beta (its skill is gone)"* ]]
	[ ! -L "$dest/beta" ]
}

@test "skills eval: with the skill the fake model passes, without it fails, lift is shown, -t gates" {
	F=$BATS_TEST_DIRNAME/fake/fake-model
	export SKILLS_DIR=$BATS_TEST_DIRNAME/../skills
	run "$BATS_TEST_DIRNAME/../bin/skills" eval -b cmd -c "$F" code
	[ "$status" -eq 0 ]
	[[ "$output" == *"code: with skill 2/2, without 0/2, lift +2"* ]]
	run "$BATS_TEST_DIRNAME/../bin/skills" eval -n -b cmd -c "true" -t 100 code
	[ "$status" -eq 1 ]
	[[ "$output" == *"FAIL with skill: 001-no-ceremony (missing /-l/)"* ]]
	run "$BATS_TEST_DIRNAME/../bin/skills" eval -b cmd -c "$F" nosuchskill
	[ "$status" -eq 2 ]
}

@test "skills export: a card under the cap, parts with paths, router written, over-cap exits 1 but still writes" {
	export SKILLS_DIR=$BATS_TEST_DIRNAME/../skills
	run "$BATS_TEST_DIRNAME/../bin/skills" export -m 100000 code
	[ "$status" -eq 0 ]
	[[ "$output" == "# code"* && "$output" == *"skills/code/references/saas.md"* ]]
	run "$BATS_TEST_DIRNAME/../bin/skills" export -m 200 -o "$BATS_TEST_TMPDIR/out" code rules
	[ "$status" -eq 1 ]
	[ -s "$BATS_TEST_TMPDIR/out/cards/code.md" ] && grep -q '^- code:' "$BATS_TEST_TMPDIR/out/AGENTS.md"
	run "$BATS_TEST_DIRNAME/../bin/skills" export nosuch
	[ "$status" -eq 2 ]
}

@test "skills find: ranks the matching chunk first with path:line, -s limits, no hit exits 1, bad usage 2" {
	export SKILLS_DIR=$BATS_TEST_DIRNAME/../skills
	run "$BATS_TEST_DIRNAME/../bin/skills" find compress a prose file
	[ "$status" -eq 0 ]
	[[ "${lines[0]}" == skills/code/references/compress.md:* ]]
	run "$BATS_TEST_DIRNAME/../bin/skills" find -s model-surgery -k 1 quantize vram
	[[ "${lines[0]}" == skills/model-surgery/* ]]
	run "$BATS_TEST_DIRNAME/../bin/skills" find zzzqqxx
	[ "$status" -eq 1 ]
	run "$BATS_TEST_DIRNAME/../bin/skills" find
	[ "$status" -eq 2 ]
}

@test "skills eval -j: passing with-skill answers become SFT lines without the skill text in the prompt" {
	export SKILLS_DIR=$BATS_TEST_DIRNAME/../skills
	run "$BATS_TEST_DIRNAME/../bin/skills" eval -n -b cmd -c "$BATS_TEST_DIRNAME/fake/fake-model" -j "$BATS_TEST_TMPDIR/sft.jsonl" code
	[ "$status" -eq 0 ]
	[ "$(wc -l < "$BATS_TEST_TMPDIR/sft.jsonl")" -eq 2 ]
	jq -e '.messages[0].role == "user" and .messages[1].content == "-l"' <(head -1 "$BATS_TEST_TMPDIR/sft.jsonl")
}

mkdoc() {	# mkdoc SKILL TEXT: a one-chunk reference file
	mkdir -p "$SKILLS_DIR/$1/references"
	printf -- '---\nname: %s\ndescription: %s skill.\n---\n\n# %s\n\n' "$1" "$1" "$1" > "$SKILLS_DIR/$1/SKILL.md"
	printf '# %s (part)\n\n%s\n' "$1" "$2" > "$SKILLS_DIR/$1/references/part.md"
}

@test "skills retrieve --lexical: ranks by words with path:line, -m caps the bytes, -s limits, usage errors exit 2" {
	export XDG_CACHE_HOME=$BATS_TEST_TMPDIR/cache
	mkdoc baking 'Mix flour, yeast and water, let the dough prove, bake at 230 degrees.'
	mkdoc engines 'Drain the oil, change the filter, refill the sump with new oil.'
	run "$S" retrieve --lexical change the oil filter
	[ "$status" -eq 0 ]
	[[ "${lines[0]}" == *engines/references/part.md:1* ]]
	run "$S" retrieve --lexical -k 5 -m 10 the dough oil
	[ "$status" -eq 0 ]
	[ "$(grep -c 'part.md:1' <<< "$output")" -eq 1 ]
	run "$S" retrieve --lexical -s baking -k 5 oil dough
	[ "$(grep -c 'part.md:1' <<< "$output")" -eq 1 ] && [[ "${lines[0]}" == *baking/* ]]
	run "$S" retrieve --lexical zzzqqxx
	[ "$status" -eq 1 ]
	run "$S" retrieve
	[ "$status" -eq 2 ]
	run "$S" retrieve -k 0 oil
	[ "$status" -eq 2 ]
	[ ! -e "$XDG_CACHE_HOME/claude-config" ]	# the lexical path never touches the cache
}

@test "skills retrieve: embeddings find a chunk that shares no word with the task, and the cache is reused until a file changes" {
	REAL_HOME=$(getent passwd "$(id -u)" | cut -d: -f6)
	export HF_HOME=${HF_HOME:-$REAL_HOME/.cache/huggingface} XDG_CACHE_HOME=$BATS_TEST_TMPDIR/cache PYTHONUSERBASE=${PYTHONUSERBASE:-$REAL_HOME/.local}
	# [ -f ] follows the snapshot symlinks: a cache whose blobs were cleaned has dangling links that ls still lists
	for f in "$HF_HOME"/hub/models--sentence-transformers--all-MiniLM-L6-v2/snapshots/*/model.safetensors; do [ -f "$f" ] && have=1; done
	[ "${have:-}" = 1 ] || skip "no local MiniLM in $HF_HOME (blobs missing or dangling)"
	python3 -c 'import numpy, tokenizers, safetensors' 2> /dev/null || skip "numpy, tokenizers or safetensors missing"
	mkdoc baking 'Mix flour, yeast and water, let the dough prove, bake at 230 degrees.'
	mkdoc engines 'Drain the oil, change the filter, refill the sump with new oil.'
	mkdoc gardening 'Water the tomato seedlings in the morning and prune the lower leaves.'
	run "$S" retrieve -k 1 how do I make a loaf of bread
	[ "$status" -eq 0 ]
	[[ "${lines[0]}" == *baking/references/part.md:1* ]]
	idx=$XDG_CACHE_HOME/claude-config/skills-index
	[ -s "$idx/vecs.npy" ] && [ -s "$idx/keys.json" ]
	m1=$(stat -c %Y.%y "$idx/vecs.npy")
	run "$S" retrieve -k 1 how do I make a loaf of bread
	[ "$(stat -c %Y.%y "$idx/vecs.npy")" = "$m1" ]	# unchanged files: no re-embedding, cache not rewritten
	printf '\nMore about rye sourdough.\n' >> "$SKILLS_DIR/baking/references/part.md"
	run "$S" retrieve -k 1 sourdough starter
	[ "$(stat -c %Y.%y "$idx/vecs.npy")" != "$m1" ]	# an edited chunk is embedded again
}
