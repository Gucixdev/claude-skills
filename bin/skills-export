#!/usr/bin/env bash
# skills-export - flat cards of the skills for a small model or an agent loop without a skill tool (Qwen on llama.cpp).
#
# A card is one markdown file under a byte cap: the skill's name, its description, its digest (the text before "## Parts")
# and its parts as "name: first sentence (path)". A part line shrinks to its name when the card is over the cap; a card
# that is still over the cap fails, which means the skill's digest is too long for a small model. A router file lists
# every skill in one line and says which card to read; point the model at it (AGENTS.md or QWEN.md in the project).
#
# usage: skills-export [-m BYTES] [-o DIR] [-r NAME] [NAME...]
#   -m BYTES  card cap, default 1500
#   -o DIR    write DIR/cards/NAME.md and DIR/AGENTS.md (default: print one card to stdout, needs exactly one NAME)
#   -r NAME   the router file name inside DIR (default AGENTS.md)
#   no NAME with -o = every skill
# Exit 0 fine, 1 a card is over the cap (it is still written, so the size can be read), 2 bad usage.
# Example: skills-export -o ~/qwen-skills; skills-export -m 1200 leanctx

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac
cap=1500 out="" router=AGENTS.md
while [ $# -gt 0 ]; do
	case $1 in -m | -o | -r) [ $# -ge 2 ] || { echo "skills-export: $1 needs a value" >&2; exit 2; } ;; esac
	case $1 in
		-m) cap=$2; shift ;; -o) out=$2; shift ;; -r) router=$2; shift ;;
		--) shift; break ;;
		-*) echo "skills-export: unknown option $1 (see --help)" >&2; exit 2 ;;
		*) break ;;
	esac
	shift
done
case $cap in '' | *[!0-9]*) echo "skills-export: -m wants a number" >&2; exit 2 ;; esac
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
S=$here/skills

names=("$@")
if [ ${#names[@]} -eq 0 ]; then
	[ -n "$out" ] || { echo "skills-export: without -o give exactly one NAME (see --help)" >&2; exit 2; }
	while IFS= read -r n; do names+=("$n"); done < <("$S" ls | cut -f1)
fi
[ -n "$out" ] || [ ${#names[@]} -eq 1 ] || { echo "skills-export: without -o give exactly one NAME" >&2; exit 2; }

# card NAME MODE -> stdout; MODE full (part lines with a first sentence) or short (part names only)
card() {
	local f desc rel
	f=$("$S" path "$1") || return 1
	rel=$(realpath --relative-to="$here/.." "$(dirname "$f")")
	desc=$(awk '/^description:/ { sub(/^description:[ \t]*/, ""); gsub(/^"|"[ \t]*$/, ""); print; exit }' "$f")
	printf '# %s\n\n%s\n' "$1" "$desc"
	awk -v mode="$2" -v dir="$rel" '
		NR == 1 && $0 == "---" { h = 1; next }
		h && $0 == "---" { h = 0; next }
		h { next }
		/^# / && !seen_h1 { seen_h1 = 1; next }
		/^<!--/ { next }
		/^## Parts/ { parts = 1; print ""; print "Parts (read the file when the task matches):"; next }
		/^Read the part when/ && parts { next }
		parts && /^- \[/ {
			name = $0; sub(/^- \[/, "", name); sub(/\].*/, "", name)
			path = $0; sub(/^[^(]*\(/, "", path); sub(/\).*/, "", path)
			if (mode == "short") { print "- " name " (" dir "/" path ")"; next }
			d = $0; sub(/^[^)]*\) - /, "", d)
			n = index(d, ". "); if (n > 0) d = substr(d, 1, n - 1)
			sub(/\.$/, "", d)
			if (length(d) > 110) d = substr(d, 1, 107) "..."
			print "- " name ": " d " (" dir "/" path ")"; next
		}
		{ print }' "$f" | cat -s
}

size_ok() { [ "$(printf '%s' "$1" | wc -c)" -le "$cap" ]; }

make() { # NAME -> card text on stdout, rc 1 when over the cap even when short
	local t
	t=$(card "$1" full) || return 2
	size_ok "$t" || t=$(card "$1" short)
	printf '%s\n' "$t"
	size_ok "$t"
}

if [ -z "$out" ]; then
	make "${names[0]}"; rc=$?
	[ $rc -eq 2 ] && echo "skills-export: unknown skill ${names[0]}" >&2
	[ $rc -eq 1 ] && echo "skills-export: ${names[0]} is over $cap bytes even in short form" >&2
	exit $rc
fi

mkdir -p "$out/cards" || exit 2
rc=0
: > "$out/$router.tmp"
{
	printf '# Skills\n\nBefore a task, pick the one skill whose line below matches it and read its card (cards/NAME.md).\n'
	printf 'A card ends with its parts; read a part file only when the task matches it. One skill at a time.\n\n'
} >> "$out/$router.tmp"
for n in "${names[@]}"; do
	if t=$(make "$n"); then :; else
		r=$?
		[ $r -eq 2 ] && { echo "skills-export: unknown skill $n" >&2; rc=2; continue; }
		echo "skills-export: $n is $(printf '%s' "$t" | wc -c) bytes, over the cap of $cap even in short form" >&2; [ $rc -eq 0 ] && rc=1
	fi
	printf '%s\n' "$t" > "$out/cards/$n.md"
	first=$("$S" ls | awk -F'\t' -v n="$n" '$1 == n { d = $NF; i = index(d, ". "); if (i > 0) d = substr(d, 1, i - 1); print substr(d, 1, 160) }')
	printf -- '- %s: %s\n' "$n" "$first" >> "$out/$router.tmp"
done
mv "$out/$router.tmp" "$out/$router"
printf 'wrote %d cards and %s in %s\n' "${#names[@]}" "$router" "$out" >&2
exit $rc
