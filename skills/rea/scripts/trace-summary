#!/usr/bin/env bash
# trace-summary - what a program touched, from an strace log: files it opened (and which of them it wrote to),
# programs it started, network addresses it connected to, files it failed to find.
#
# usage: trace-summary LOG            summarize a log made with: strace -f -o LOG CMD
#        trace-summary -r CMD...      run CMD under strace into a temporary log, then summarize it
# The log must come from `strace -f` without -e filters that drop openat, execve or connect.
# Reads only; with -r the program runs for real, so only run what you would run anyway.
# Exit 0, 2 on bad usage or when strace is missing.

case ${1:-} in -h | --help | '') awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; [ -n "${1:-}" ]; exit $(($? == 0 ? 0 : 2)) ;; esac

if [ "$1" = -r ]; then
	shift
	[ $# -gt 0 ] || { echo "trace-summary: -r needs a command" >&2; exit 2; }
	command -v strace > /dev/null || { echo "trace-summary: strace not installed" >&2; exit 2; }
	log=$(mktemp) && trap 'rm -f "$log"' EXIT
	strace -f -o "$log" "$@" > /dev/null 2>&1 || true
else
	log=$1
	[ -r "$log" ] || { echo "trace-summary: cannot read $log" >&2; exit 2; }
fi

section() { printf '\n%s\n' "$1"; }
cap() { sort | uniq -c | sort -rn | head -"${N:-15}" | sed 's/^ *//'; }

section "programs started"
grep -oE 'execve\("[^"]+"' "$log" | sed 's/execve("//; s/"$//' | cap

section "files opened for writing (O_WRONLY, O_RDWR, O_CREAT)"
grep -E 'open(at)?\(.*(O_WRONLY|O_RDWR|O_CREAT)' "$log" | grep -v '= -1' | grep -oE '"[^"]+"' | tr -d '"' | grep -vE '^/(dev|proc|sys)/' | cap

section "files read (opened O_RDONLY, successful, no /proc /sys /dev, no libraries)"
grep -E 'open(at)?\(' "$log" | grep 'O_RDONLY' | grep -v '= -1' | grep -oE '"[^"]+"' | tr -d '"' |
	grep -vE '^/(dev|proc|sys)/|\.so(\.[0-9]+)*$|^/etc/ld\.so|/locale|/gconv|\.mo$' | cap

section "network: connect()"
grep -E 'connect\(' "$log" | grep -oE 'sa_family=AF_[A-Z0-9]+, [^}]*' | sed -E 's/sin6?_(port|path)=//; s/htons\(([0-9]+)\)/\1/; s/inet_(pton|addr)\(AF_INET6?, //' | cap

section "looked for and not found (ENOENT; the shell's PATH search for the programs above is left out)"
progs=$(grep -oE 'execve\("[^"]+"' "$log" | sed 's/execve("//; s/"$//; s#.*/##' | sort -u | paste -sd'|')
grep 'ENOENT' "$log" | grep -v 'execve(' | grep -E 'open(at)?\(|stat|access' | grep -oE '"[^"]+"' | tr -d '"' |
	grep -vE '\.so|/locale|ld\.so|gconv|/proc/|/sys/' | grep -vE "/(${progs:-@@})\$" | cap
