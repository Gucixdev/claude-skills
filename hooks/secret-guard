#!/usr/bin/env bash
# secret-guard - Claude Code PreToolUse hook for Write|Edit|MultiEdit: refuses to write something that looks like a real
# secret (private key block, AWS/GitHub/Groq/OpenAI-style/Slack/HuggingFace/Google API key) into a file. Secrets live only
# in ~/.secrets and ~/.config/openapi/keys.env (those two are allowed), everything else reads them from the environment.
# A line that says example/fake/dummy/placeholder/xxxx is a sample and passes. The message names the kind, never the value.
# Enable (you, in settings.json): hooks.PreToolUse, matcher "Write|Edit|MultiEdit".
input=$(cat)
path=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2> /dev/null)
text=$(printf '%s' "$input" | jq -r '[.tool_input.content, .tool_input.new_string, (.tool_input.edits[]?.new_string)] | map(select(. != null)) | join("\n")' 2> /dev/null)
[ -n "$text" ] || exit 0
case $path in */.secrets | */.secrets/* | */openapi/keys.env) exit 0 ;; esac
kinds=''
check() { # name regex
	local hit
	hit=$(printf '%s\n' "$text" | grep -E -- "$2" | grep -viE 'example|fake|dummy|placeholder|x{6,}|<[a-z_ -]*key[a-z_ -]*>' | head -1)
	[ -z "$hit" ] || kinds="$kinds $1"
}
check private-key '-----BEGIN ([A-Z]+ )?PRIVATE KEY'
check aws-key '(^|[^A-Za-z0-9])AKIA[0-9A-Z]{16}([^A-Za-z0-9]|$)'
check github-token '(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}'
check groq-key 'gsk_[A-Za-z0-9]{40,}'
check openai-style-key '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{32,}'
check slack-token 'xox[baprs]-[A-Za-z0-9-]{20,}'
check huggingface-token '(^|[^A-Za-z0-9])hf_[A-Za-z0-9]{34,}'
check google-api-key 'AIza[0-9A-Za-z_-]{35}'
[ -n "$kinds" ] || exit 0
printf 'secret-guard: the text for %s looks like a real secret (%s ). Nothing was written.\nPut it in ~/.secrets (or ~/.config/openapi/keys.env) and read it from the environment; if it is a sample, mark the line "example" or "fake".\n' "${path:-a file}" "${kinds# }" >&2
exit 2
