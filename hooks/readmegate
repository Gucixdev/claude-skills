#!/usr/bin/env bash
# readmegate - Claude Code PreToolUse hook for Write|Edit|MultiEdit on README*.md: a README is read by others
# (conventions (readme)), so a Write or an Edit that brings "xD" into one is refused. Length is not limited. His own
# notes (braindump, todo, questions) are not READMEs and are not touched.
#
# READMEGATE=off disables it. Needs jq; without it the hook does nothing.
# Enable (you, in settings.json): hooks.PreToolUse, matcher "Write|Edit|MultiEdit".

# shellcheck source=/dev/null disable=SC2154
. "$(dirname "$(readlink -f "$0")")/smartgates"
sg_init
[ "${READMEGATE:-on}" = off ] && exit 0
f=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty')
case ${f##*/} in README | README.md | README.*.md | readme.md) ;; *) exit 0 ;; esac
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty')
if [ "$tool" = Write ]; then
	text=$(printf '%s' "$input" | jq -r '.tool_input.content // empty')
else
	text=$(printf '%s' "$input" | jq -r '[.tool_input.new_string, (.tool_input.edits[]?.new_string)] | map(select(. != null)) | join("\n")')
fi
printf '%s' "$text" | grep -qiE '(^|[^[:alpha:]])xd([^[:alpha:]]|$)' || exit 0
sg_block "readmegate: $(basename -- "$(dirname -- "$f")")/${f##*/} refused: it has an xD. A README is read by others."
