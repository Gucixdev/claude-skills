#!/usr/bin/env bash
# vram-fit - will this model fit in VRAM, and if not, how many layers to offload (-ngl)?
#
# Estimate: weights = params * bits / 8; KV cache = 2 * layers * ctx * kv_heads * head_dim * bytes per element;
# plus overhead (CUDA context, compute buffers; 0.3 GB default). A guess to plan with, within about 10 percent:
# the real answer is `llama-cli ... -ngl N` and `nvidia-smi`.
#
# usage: vram-fit -p PARAMS_B -b BITS [options]
#   -p B      parameters in billions (1.7, 8, ...)
#   -b BITS   bits per weight: 16 bf16, 8.5 Q8_0, 4.85 Q4_K_M, 4.25 IQ4_XS, 3.9 Q3_K_M, 2.4 IQ2_XS; 1.6 ternary
#   -c CTX    context tokens (default 4096)
#   -m FILE   a Hugging Face config.json: fills -l -k -d (layers, KV heads, head dimension)
#   -l N -k N -d N   layers, KV heads, head dimension when there is no config
#   -q BITS   KV cache bits per element (default 16; 8 with `-ctk q8_0 -ctv q8_0`)
#   -v GB     VRAM available (default: the first GPU's free memory from nvidia-smi, else 4)
#   -o GB     overhead (default 0.3)
# Prints a table, then FITS, or the largest -ngl that fits. Exit 0 fits, 1 does not fit completely, 2 bad usage.

case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac

p="" b="" ctx=4096 cfg="" L="" K="" D="" q=16 vram="" ovh=0.3
while [ $# -gt 0 ]; do
	[ $# -ge 2 ] || { echo "vram-fit: $1 needs a value (see --help)" >&2; exit 2; }
	case $1 in
		-p) p=$2 ;; -b) b=$2 ;; -c) ctx=$2 ;; -m) cfg=$2 ;; -l) L=$2 ;; -k) K=$2 ;; -d) D=$2 ;; -q) q=$2 ;; -v) vram=$2 ;; -o) ovh=$2 ;;
		*) echo "vram-fit: unknown option $1 (see --help)" >&2; exit 2 ;;
	esac
	shift 2
done
[ -n "$p" ] && [ -n "$b" ] || { echo "vram-fit: -p and -b are required (see --help)" >&2; exit 2; }
if [ -n "$cfg" ]; then
	command -v jq > /dev/null || { echo "vram-fit: -m needs jq" >&2; exit 2; }
	[ -f "$cfg" ] || { echo "vram-fit: no such file: $cfg" >&2; exit 2; }
	# some configs nest the text model under text_config
	read -r L K D < <(jq -r '(.text_config // .) | [.num_hidden_layers, (.num_key_value_heads // .num_attention_heads), (.head_dim // ((.hidden_size) / (.num_attention_heads) | floor))] | @tsv' "$cfg")
	[ -n "$L" ] && [ "$L" != null ] || { echo "vram-fit: $cfg has no num_hidden_layers" >&2; exit 2; }
fi
if [ -z "$vram" ]; then
	vram=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2> /dev/null | head -1 | awk '{ printf "%.2f", $1 / 1024 }')
	vram=${vram:-4}
fi

awk -v p="$p" -v b="$b" -v ctx="$ctx" -v L="${L:-0}" -v K="${K:-0}" -v D="${D:-0}" -v q="$q" -v v="$vram" -v o="$ovh" 'BEGIN {
	w = p * 1e9 * b / 8 / 2^30
	kv = (L > 0) ? 2 * L * ctx * K * D * q / 8 / 2^30 : 0
	tot = w + kv + o
	printf "weights   %6.2f GB  (%.2f B params x %.2f bits)\n", w, p, b
	if (L > 0) printf "KV cache  %6.2f GB  (%d layers, %d KV heads x %d, ctx %d, %d-bit)\n", kv, L, K, D, ctx, q
	else printf "KV cache  unknown   (give -m config.json or -l -k -d; it grows with context)\n"
	printf "overhead  %6.2f GB\n", o
	printf "total     %6.2f GB  of %.2f GB VRAM\n", tot, v
	if (tot <= v) { print "FITS"; exit 0 }
	if (L > 0) {
		per = (w + kv) / L                     # embeddings and the output layer are lumped into the layers: a slight underestimate of the cost
		n = int((v - o) / per); if (n < 0) n = 0
		printf "does not fit: -ngl %d of %d layers on the GPU (%.2f GB), the rest on CPU RAM (%.2f GB)\n", n, L, n * per + o, (L - n) * per
	} else printf "does not fit: over by %.2f GB; lower bits, ctx, or offload layers with -ngl\n", tot - v
	exit 1
}'
