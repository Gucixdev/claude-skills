#!/usr/bin/env bash
# skills - the skills in this repo, read from their headers: list, filter by #tag, check requirements, validate,
# rebuild the index, install.
#
#   skills ls [#TAG...]         name, priority, tags, description as TSV; only skills carrying every #TAG
#   skills tags                 every #tag with its count and its skills
#   skills path NAME            path of NAME's SKILL.md
#   skills req NAME...          what NAME needs, and what every skill it requires needs, checked on this machine
#   skills check [NAME...]      validate the headers (claude.ai's rules plus this repo's standard) and the index
#   skills index                rewrite the generated map in skills/claude/SKILL.md
#   skills eval [options] [NAME...]   run evals/NAME/*.case with and without the skill (see skills-eval --help)
#   skills find [-k N] [-b BYTES] [-s NAME] QUERY...   the few best chunks of all skill text (BM25), with path:line
#   skills retrieve [-k N] [-m BYTES] [-s NAME] [--lexical] TASK...   top chunks by meaning plus words (cached embeddings), capped
#   skills export [options] [NAME...]   flat size-capped cards plus an AGENTS.md router for small models (see skills-export --help)
#   skills factory queue|list|next|digest|done ...   every session into a skill: digests of finished sessions, waiting
#                               for the next one to turn them into skills (see skills-factory --help)
#   skills install [-n] [DIR]   link every skill into DIR (default ~/.claude/skills); whatever was in the way goes to
#                               the trash, never deleted; -n prints what it would do
#
# The header standard is in skills/skill-everything/SKILL.md. SKILLS_DIR overrides the skills/ folder next to bin/.
# Exit status: 0 fine, 1 a check failed or a requirement is missing, 2 bad usage.
# Example: skills ls '#bash' '#cli'; skills req bash-everything; skills check && skills install
set -u

ALLOWED_KEYS=" name description license allowed-tools metadata compatibility metadata.priority metadata.tags metadata.requires metadata.upstream "
REQ_TYPES='skill|cmd|lib|py|node|mcp|env|file|font|el'
INDEX_FILE=claude/SKILL.md
INDEX_BEGIN='<!-- skills:index generated by bin/skills index; edit the skills, not this block -->'
INDEX_END='<!-- /skills:index -->'

die() { printf 'skills: %s\n' "$*" >&2; exit 2; }

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

if [ -n "${SKILLS_DIR:-}" ]; then
	DIR=$SKILLS_DIR
else
	DIR=$(cd "$(dirname "$(readlink -f "$0")")/../skills" 2> /dev/null && pwd) || die "no skills/ folder next to bin/; set SKILLS_DIR"
fi
[ -d "$DIR" ] || die "$DIR is not a folder"

# table: one row per skill, fields split by US (\037, not a tab: read squeezes runs of tabs and loses empty fields),
# the header parsed once for every command: dir name priority tags requires upstream description keys errors body_lines
# A skill is DIR/NAME/SKILL.md, or DIR/GROUP/NAME/SKILL.md when GROUP is a plain folder that only collects skills
# (it has no SKILL.md itself); install links every skill flat, by NAME.
skill_files() { find "$DIR" -mindepth 2 -maxdepth 3 -name SKILL.md -not -path '*/references/*' | sort; }
skill_file() {	# NAME -> path of its SKILL.md
	local f
	for f in "$DIR/$1/SKILL.md" "$DIR"/*/"$1"/SKILL.md; do [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }; done
	return 1
}

table() {
	local files
	mapfile -t files < <(skill_files)
	[ ${#files[@]} -gt 0 ] || return 0
	awk '
	function unq(v) {
		if (v ~ /^".*"$/) { v = substr(v, 2, length(v) - 2); gsub(/\\"/, "\"", v); return v }
		if (v ~ /^\x27.*\x27$/) { v = substr(v, 2, length(v) - 2); gsub(/\x27\x27/, "\x27", v); return v }
		return v
	}
	function err(m) { e = e (e == "" ? "" : "; ") m }
	function value(key, v) {
		sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); gsub(/[\t\037]/, " ", v)
		if (v ~ /^[>|]/) err(key ": keep it on one line (no folded or literal block)")
		else if (v ~ /^"/ && v !~ /^".*"$/ || v ~ /^\x27/ && v !~ /^\x27.*\x27$/) err(key ": unbalanced quotes")
		else if (v !~ /^["\x27]/ && (v ~ /: / || v ~ / #/ || v ~ /^[#\[\]{}*&!%@`,?]/))
			err(key ": quote this value, YAML reads a \": \", \" #\" or a leading symbol differently")
		if (key in k) err(key ": given twice")
		keys = keys " " key
		k[key] = unq(v)
	}
	function flush(   n, p) {
		if (file == "") return
		if (state == 1) err("the frontmatter is not closed with ---")
		n = split(file, p, "/")
		printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%d\n", p[n - 1], k["name"], k["metadata.priority"], k["metadata.tags"],
			k["metadata.requires"], k["metadata.upstream"], k["description"], keys, e, body
	}
	FNR == 1 {
		flush(); file = FILENAME; split("", k); keys = ""; e = ""; body = 0; sect = ""
		if ($0 == "---") state = 1; else { state = 2; err("no frontmatter, the first line must be ---") }
		next
	}
	state == 1 && /^---[ \t]*$/ { state = 2; next }
	state == 1 && /^[ \t]*(#.*)?$/ { next }
	state == 1 && /^[A-Za-z][A-Za-z0-9_-]*:/ {
		match($0, /^[A-Za-z][A-Za-z0-9_-]*:/); key = substr($0, 1, RLENGTH - 1); rest = substr($0, RLENGTH + 1); sect = key
		if (key == "metadata") { keys = keys " metadata"; if (rest !~ /^[ \t]*$/) err("metadata: must be an indented block"); next }
		value(key, rest); next
	}
	state == 1 && /^[ \t]+[A-Za-z][A-Za-z0-9_-]*:/ {
		line = $0; sub(/^[ \t]+/, "", line); match(line, /^[A-Za-z][A-Za-z0-9_-]*:/)
		key = substr(line, 1, RLENGTH - 1); rest = substr(line, RLENGTH + 1)
		if (sect != "metadata") { err("indented key outside metadata: " key); next }
		value("metadata." key, rest); next
	}
	state == 1 { err("cannot parse: " $0); next }
	{ body++ }
	END { flush() }
	' "${files[@]}"
}

has_tags() {	# has_tags "TAGS" WANTED...: every WANTED tag is in TAGS
	local t=" $1 "
	shift
	for w; do case $t in *" $w "*) ;; *) return 1 ;; esac; done
}

cmd_ls() {
	local want=() w out
	for w; do case $w in '#'*) want+=("$w") ;; *) want+=("#$w") ;; esac; done
	out=$(table | while IFS=$'\037' read -r dir name prio tags _ _ desc _; do
		has_tags "$tags" "${want[@]}" && printf '%s\t%s\t%s\t%s\n' "${name:-$dir}" "$prio" "$tags" "$desc"
	done)
	[ -n "$out" ] || return 1
	if [ -t 1 ] && command -v column > /dev/null; then
		printf '%s\n' "$out" | column -t -s $'\t' | cut -c "1-${COLUMNS:-$(tput cols 2> /dev/null || echo 160)}"
	else
		printf '%s\n' "$out"
	fi
}

cmd_tags() {
	table | awk -F '\037' '{ n = split($4, t, " "); for (i = 1; i <= n; i++) { c[t[i]]++; s[t[i]] = s[t[i]] " " $2 } }
		END { for (x in c) printf "%s\t%d\t%s\n", x, c[x], substr(s[x], 2) }' | sort -t $'\t' -k2,2nr -k1,1
}

cmd_path() {
	[ $# -eq 1 ] || die "usage: skills path NAME"
	skill_file "$1" || { echo "skills: no skill $1" >&2; return 1; }
}

# req_check ITEM: prints "STATUS<TAB>ITEM<TAB>detail"; status ok, missing, optional (missing but optional) or
# unknown (cannot be checked here). Returns 1 only for a missing required item.
req_check() {
	local item=$1 opt='' type val alt found='' detail=''
	case $item in '?'*) opt=1 item=${item#?} ;; esac
	type=${item%%:*} val=${item#*:}
	val=${val//+/ }
	case $type in
	skill)
		if detail=$(skill_file "$val"); then found=1 detail=${detail%/SKILL.md}
		else
			for alt in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/${val##*:}" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/skills/synced/*/"${val##*:}"; do
				[ -f "$alt/SKILL.md" ] && { found=1 detail=$alt; break; }
			done
			[ -n "$found" ] || [ "${val#*:}" = "$val" ] || { printf 'unknown\t%s\tnot installed here; an account or plugin skill\n' "$1"; return 0; }
		fi ;;
	cmd)
		local IFS='|'
		for alt in $val; do command -v "$alt" > /dev/null 2>&1 && { found=1 detail=$(command -v "$alt"); break; }; done ;;
	lib)
		if command -v pkg-config > /dev/null && pkg-config --exists "$val"; then found=1 detail="pkg-config $val $(pkg-config --modversion "$val")"
		elif command -v ldconfig > /dev/null && ldconfig -p 2> /dev/null | grep -q "lib$val\.so"; then found=1 detail="ldconfig lib$val.so"
		fi ;;
	py)
		[[ $val =~ ^[A-Za-z_][A-Za-z0-9_.]*$ ]] || { printf 'missing\t%s\tnot a module name\n' "$1"; return 1; }
		command -v python3 > /dev/null && python3 -I -c "import $val" 2> /dev/null && found=1 detail=python3 ;;
	node)
		{ [ -d "node_modules/$val" ] || { command -v npm > /dev/null && npm ls -g --depth=0 "$val" > /dev/null 2>&1; }; } && found=1 detail=npm ;;
	mcp)
		command -v claude > /dev/null || { printf 'unknown\t%s\tno claude cli to ask\n' "$1"; return 0; }
		claude mcp get "$val" > /dev/null 2>&1 && found=1 detail="claude mcp get $val" ;;
	env)
		[[ $val =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { printf 'missing\t%s\tnot a variable name\n' "$1"; return 1; }
		[ -n "${!val:-}" ] && found=1 detail=set ;;
	file)
		case $val in \~/*) val=$HOME/${val#\~/} ;; esac
		[ -e "$val" ] && found=1 detail=$val ;;
	font)
		command -v fc-list > /dev/null || { printf 'unknown\t%s\tno fc-list\n' "$1"; return 0; }
		fc-list : family | grep -qiF -- "$val" && found=1 detail=$(fc-list : family | grep -iF -m1 -- "$val") ;;
	el)
		command -v emacs > /dev/null || { [ -n "$opt" ] && printf 'optional\t%s\tno emacs\n' "$1" || printf 'missing\t%s\tno emacs\n' "$1"; [ -n "$opt" ]; return; }
		local q="(princ (if (locate-library \"$val\") \"yes\" \"no\"))"
		if command -v emacsclient > /dev/null && [ "$(emacsclient -a false --eval "$q" 2> /dev/null)" = '"yes"' ]; then found=1 detail="emacs daemon"
		elif [ "$(emacs -Q --batch --eval "(progn (package-initialize) $q)" 2> /dev/null)" = yes ]; then found=1 detail="emacs --batch"
		fi ;;
	*) printf 'missing\t%s\tunknown type %s (one of %s)\n' "$1" "$type" "${REQ_TYPES//|/ }"; return 1 ;;
	esac
	if [ -n "$found" ]; then printf 'ok\t%s\t%s\n' "$1" "$detail"
	elif [ -n "$opt" ]; then printf 'optional\t%s\tnot here\n' "$1"
	else printf 'missing\t%s\tnot here\n' "$1"; return 1
	fi
}

cmd_req() {
	[ $# -gt 0 ] || die "usage: skills req NAME..."
	local tab queue=("$@") seen=" " name row reqs item rc=0
	tab=$(table)
	while [ ${#queue[@]} -gt 0 ]; do
		name=${queue[0]} queue=("${queue[@]:1}")
		case $seen in *" $name "*) continue ;; esac
		seen="$seen$name "
		row=$(printf '%s\n' "$tab" | awk -F '\037' -v n="$name" '$1 == n')
		[ -n "$row" ] || { printf 'missing\tskill:%s\tno such skill in %s\n' "$name" "$DIR"; rc=1; continue; }
		reqs=$(printf '%s\n' "$row" | cut -d $'\037' -f5)
		printf '# %s\n' "$name"
		for item in $reqs; do
			req_check "$item" || rc=1
			case $item in skill:* | '?skill:'*) item=${item#\?}; item=${item#skill:}; skill_file "$item" > /dev/null && queue+=("$item") ;; esac
		done
	done
	return $rc
}

index_text() {	# the generated map: every skill under its priority with its tags; descriptions are in the skill listing already
	table | sort -t $'\037' -k3,3n -k2,2 | awk -F '\037' '
	BEGIN {
		h[0] = "Priority 0 - always: load these at the start of every session"
		h[1] = "Priority 1 - load as soon as the task touches their tags"
		h[2] = "Priority 2 - load when the task is one of these"
		h[3] = "Priority 3 - only when he names it"
	}
	{
		if (NR == 1 || $3 != last) { if (NR > 1) print ""; print "### " (($3 in h) ? h[$3] : "Priority " $3); last = $3 }
		printf "- `%s` %s\n", $2, $4
	}'
}

cmd_index() {
	local f=$DIR/$INDEX_FILE new
	[ -f "$f" ] || die "no $f"
	if ! grep -qxF -- "$INDEX_BEGIN" "$f" || ! grep -qxF -- "$INDEX_END" "$f"; then die "$f has no index block ($INDEX_BEGIN ... $INDEX_END)"; fi
	new=$(index_text | awk -v b="$INDEX_BEGIN" -v e="$INDEX_END" 'FNR == NR { gen = gen $0 "\n"; next }
		$0 == b { print; printf "%s", gen; skip = 1; next } $0 == e { skip = 0 } !skip' - "$f") || return 1
	[ "$new" = "$(cat "$f")" ] && return 0
	printf '%s\n' "$new" > "$f"
	echo "skills: index rewritten in $f" >&2
}

cmd_check() {
	local tab rc=0 dir name prio tags reqs desc keys errs body problems k t item n only=" $* " edges
	tab=$(table)
	[ -n "$tab" ] || { echo "skills: no skills in $DIR" >&2; return 1; }
	while IFS=$'\037' read -r dir name prio tags reqs _ desc keys errs body; do
		[ "$only" = "  " ] || case $only in *" $dir "*) ;; *) continue ;; esac
		problems=()
		[ -n "$errs" ] && problems+=("$errs")
		[ "$name" = "$dir" ] || problems+=("name '$name' is not the folder name '$dir'")
		[[ $name =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] && [ ${#name} -le 64 ] || problems+=("name: kebab-case, at most 64 characters")
		[ -n "$desc" ] || problems+=("description is missing")
		[ ${#desc} -le 1024 ] || problems+=("description is ${#desc} characters, at most 1024")
		case $desc in *'<'* | *'>'*) problems+=("description: no angle brackets") ;; esac
		for k in $keys; do case $ALLOWED_KEYS in *" $k "*) ;; *) problems+=("unknown key $k") ;; esac; done
		[[ $prio =~ ^[0-3]$ ]] || problems+=("metadata.priority: 0, 1, 2 or 3")
		[ -n "$tags" ] || problems+=("metadata.tags: at least one #tag")
		for t in $tags; do [[ $t =~ ^#[a-z0-9][a-z0-9-]*$ ]] || problems+=("tag '$t': #lowercase-words"); done
		[ -z "$(printf '%s' "$tags" | tr -s ' ' '\n' | sort | uniq -d)" ] || problems+=("a tag is listed twice")
		for item in $reqs; do
			if ! [[ $item =~ ^\??($REQ_TYPES):[^[:space:]]+$ ]]; then problems+=("requires '$item': TYPE:VALUE, TYPE one of ${REQ_TYPES//|/ }")
			else
				case $item in
				skill:* | '?skill:'*)
					item=${item#\?} item=${item#skill:}
					[ "$item" != "$dir" ] || problems+=("requires itself")
					case $item in *:*) ;; *) skill_file "$item" > /dev/null || problems+=("requires skill:$item, which is not in this repo (an account skill takes its full id, plugin:name)") ;; esac ;;
				esac
			fi
		done
		[ "$body" -gt 0 ] || problems+=("empty body")
		n=$(find "$(dirname "$(skill_file "$dir")")" -name SKILL.md | wc -l)
		[ "$n" -eq 1 ] || problems+=("$n SKILL.md files; one per skill, other docs get other names")
		if [ ${#problems[@]} -gt 0 ]; then
			rc=1
			for k in "${problems[@]}"; do printf '%s: %s\n' "$dir" "$k"; done
		fi
		[ "$body" -le 500 ] || printf '%s: warning: %d lines, keep it under 500 (move detail into a reference file)\n' "$dir" "$body"
	done <<< "$tab"
	edges=$(printf '%s\n' "$tab" | awk -F '\037' '{ n = split($5, r, " "); for (i = 1; i <= n; i++) { x = r[i]; sub(/^\?/, "", x); if (x ~ /^skill:[^:]+$/) print $1, substr(x, 7) } }')
	if [ -n "$edges" ] && ! printf '%s\n' "$edges" | tsort > /dev/null 2>&1; then
		echo "requires: skills require each other in a loop:"; printf '%s\n' "$edges" | tsort 2>&1 > /dev/null | sed 's/^/  /'
		rc=1
	fi
	if [ "$only" = "  " ] && [ -f "$DIR/$INDEX_FILE" ]; then
		if ! grep -qxF -- "$INDEX_BEGIN" "$DIR/$INDEX_FILE"; then echo "$INDEX_FILE: no index block"; rc=1
		elif [ "$(index_text)" != "$(awk -v b="$INDEX_BEGIN" -v e="$INDEX_END" '$0 == e { exit } on; $0 == b { on = 1 }' "$DIR/$INDEX_FILE")" ]; then
			echo "$INDEX_FILE: the index is stale, run: skills index"; rc=1
		fi
	fi
	[ $rc -eq 0 ] && printf 'skills: %d skills, headers fine\n' "$(printf '%s\n' "$tab" | grep -c .)" >&2
	return $rc
}

trash() {	# trash PATH: into the freedesktop trash (his trash tool, gio, trash-put, or by hand); nothing is deleted
	local t
	t=$(type -P trash) && "$t" "$1" > /dev/null 2>&1 && [ ! -e "$1" ] && [ ! -L "$1" ] && return
	command -v gio > /dev/null && gio trash -- "$1" 2> /dev/null && return
	command -v trash-put > /dev/null && trash-put -- "$1" 2> /dev/null && return
	t=${XDG_DATA_HOME:-$HOME/.local/share}/Trash
	local base n=1 to
	base=$(basename -- "$1") to=$base
	mkdir -p "$t/files" "$t/info" || return
	while [ -e "$t/files/$to" ] || [ -e "$t/info/$to.trashinfo" ]; do n=$((n + 1)) to="$base.$n"; done
	# shortcut: Path is not percent-encoded as the spec asks; fine for the paths this tool trashes
	printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' "$(realpath -s -- "$1")" "$(date +%Y-%m-%dT%H:%M:%S)" > "$t/info/$to.trashinfo" &&
		mv -- "$1" "$t/files/$to"
}

cmd_install() {
	local dry='' dest skill name target link
	[ "${1:-}" = -n ] && { dry=1; shift; }
	dest=${1:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills}
	[ -n "$dry" ] || mkdir -p "$dest" || return 1
	for skill in $(skill_files | sed 's|/SKILL.md$||'); do
		name=${skill##*/} target=$dest/$name
		if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$(readlink -f "$skill")" ]; then continue; fi
		if [ -e "$target" ] || [ -L "$target" ]; then
			echo "trash $target"
			[ -n "$dry" ] || trash "$target" || { echo "skills: could not trash $target" >&2; return 1; }
		fi
		echo "link $target -> $skill"
		[ -n "$dry" ] || ln -s "$skill" "$target" || return 1
	done
	# links into this repo whose skill is gone (merged, moved to trash/) go to the trash too
	for link in "$dest"/*; do
		if [ ! -L "$link" ] || [ -e "$link" ]; then continue; fi
		case $(readlink "$link") in "$DIR"/*) ;; *) continue ;; esac
		echo "trash $link (its skill is gone)"
		[ -n "$dry" ] || trash "$link"
	done
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
ls) cmd_ls "$@" ;;
tags) cmd_tags ;;
path) cmd_path "$@" ;;
req) cmd_req "$@" ;;
check) cmd_check "$@" ;;
index) cmd_index ;;
install) cmd_install "$@" ;;
find) exec "$(dirname "$(readlink -f "$0")")/skills-find" "$@" ;;
retrieve) exec "$(dirname "$(readlink -f "$0")")/skills-retrieve" "$@" ;;
export) exec "$(dirname "$(readlink -f "$0")")/skills-export" "$@" ;;
eval) exec "$(dirname "$(readlink -f "$0")")/skills-eval" "$@" ;;
factory) exec "$(dirname "$(readlink -f "$0")")/skills-factory" "$@" ;;
-h | --help | help) usage ;;
'') usage >&2; exit 2 ;;
*) die "unknown command $cmd (ls, tags, path, req, check, index, eval, export, find, retrieve, install)" ;;
esac
