#!/usr/bin/env python3
"""pulsestat - what a captured digital signal is: PWM (frequency, duty), a UART (baud), a clock, or a one-off.

usage: pulsestat [-c COL] [-r SAMPLERATE] FILE|-
Input is one of:
  edges   lines of "time level" (separator space, comma or tab; time in seconds, level 0 or 1), one line per
          change of level
  samples a sigrok-cli CSV capture (sigrok-cli ... -O csv): a "; Samplerate" comment, then one row per sample with
          one column per channel; pick the channel with -c (0 = first column, default 0). -r overrides the rate.
Prints: edges seen, idle level, shortest, median and longest pulse (high and low), and a reading:
a periodic signal as frequency and duty cycle, a bit stream as the baud rate nearest the shortest pulse.
Reads only. Exit 0, 2 on bad usage or input with fewer than 3 edges.
"""
import re, statistics, sys

STD = [300, 600, 1200, 2400, 4800, 9600, 14400, 19200, 28800, 38400, 57600, 115200, 230400, 460800, 921600]


def usage():
    sys.stderr.write(__doc__)
    sys.exit(2)


def read_edges(f, col, rate):
    edges, prev, i = [], None, 0
    for line in f:
        line = line.strip()
        if not line:
            continue
        if line.startswith(";"):
            m = re.search(r"Samplerate:\s*([\d.]+)\s*(k|M|G)?Hz", line, re.I)
            if m and rate is None:
                rate = float(m.group(1)) * {"": 1, "k": 1e3, "m": 1e6, "g": 1e9}[(m.group(2) or "").lower()]
            continue
        parts = re.split(r"[,\s]+", line)
        try:
            if len(parts) == 2 and "." in parts[0] + parts[1] or (len(parts) == 2 and rate is None):
                t, v = float(parts[0]), int(float(parts[1]))
            else:
                if rate is None:
                    raise ValueError
                t, v = i / rate, int(parts[col])
        except (ValueError, IndexError):
            continue
        i += 1
        if v != prev:
            edges.append((t, v))
            prev = v
    return edges


def main(argv):
    col, rate = 0, None
    while argv and argv[0] in ("-c", "-r"):
        if len(argv) < 2:
            usage()
        try:
            if argv[0] == "-c":
                col = int(argv[1])
            else:
                rate = float(argv[1])
        except ValueError:
            usage()
        argv = argv[2:]
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        usage()
    try:
        f = sys.stdin if argv[0] == "-" else open(argv[0])
    except OSError as e:
        sys.stderr.write("pulsestat: %s\n" % e)
        return 2
    edges = read_edges(f, col, rate)
    if len(edges) < 3:
        sys.stderr.write("pulsestat: fewer than 3 edges: nothing to measure\n")
        return 2
    hi = [edges[i + 1][0] - edges[i][0] for i in range(len(edges) - 1) if edges[i][1] == 1 and edges[i + 1][0] > edges[i][0]]
    lo = [edges[i + 1][0] - edges[i][0] for i in range(len(edges) - 1) if edges[i][1] == 0 and edges[i + 1][0] > edges[i][0]]
    print("edges %d, first level %d" % (len(edges), edges[0][1]))
    for name, v in (("high", hi), ("low", lo)):
        if v:
            print("%-5s n=%d  min %.6g s  median %.6g s  max %.6g s" % (name, len(v), min(v), statistics.median(v), max(v)))
    rises = [t for t, v in edges if v == 1]
    if len(rises) >= 3:
        periods = [b - a for a, b in zip(rises, rises[1:])]
        p = statistics.median(periods)
        spread = (max(periods) - min(periods)) / p
        if spread < 0.05 and hi and lo:
            duty = statistics.median(hi) / (statistics.median(hi) + statistics.median(lo))
            print("reading: periodic, %.6g Hz, duty %.1f %% (period spread %.1f %%)" % (1 / p, duty * 100, spread * 100))
            return 0
    short = min(w for w in hi + lo if w > 0)
    baud = 1 / short
    near = min(STD, key=lambda s: abs(s - baud))
    note = "close to the standard rate" if abs(near - baud) / near < 0.05 else "not a standard rate: inspect by hand"
    print("reading: not periodic; shortest pulse %.6g s = %.0f baud if a bit stream; nearest %d (%s)" % (short, baud, near, note))
    return 0


sys.exit(main(sys.argv[1:]))
